{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mattspi.dev/schemas/qa-spec-v1.schema.json",
  "title": "QA Spec v1",
  "description": "Freezes task intent before implementation is judged. Versioned: changes create a new revision, never a silent rewrite.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "created_at",
    "task",
    "acceptance",
    "project",
    "revision"
  ],
  "properties": {
    "schema": { "const": "mattspi.qa.spec.v1" },
    "id": { "type": "string", "pattern": "^qa-spec-" },
    "created_at": { "type": "string" },
    "task": {
      "type": "object",
      "required": ["raw_request", "normalized_intent"],
      "properties": {
        "raw_request": { "type": "string", "minLength": 1 },
        "normalized_intent": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirement"],
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]+$" },
          "requirement": { "type": "string", "minLength": 1 },
          "probe": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "consequential_seams": {
      "type": "array",
      "items": {
        "enum": [
          "persistence",
          "security",
          "concurrency",
          "migration",
          "authority",
          "network",
          "cost",
          "irreversible-state"
        ]
      }
    },
    "project": {
      "type": "object",
      "required": ["repo_root", "branch", "base_sha"],
      "properties": {
        "repo_root": { "type": "string" },
        "branch": { "type": "string" },
        "base_sha": { "type": "string" }
      },
      "additionalProperties": false
    },
    "review_depth": { "enum": ["LIGHT", "STANDARD", "DEEP"] },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": "string" }
  },
  "additionalProperties": false
}
