{
  "name": "pi-to-rule-them-all",
  "version": "0.1.0",
  "private": true,
  "description": "Matthew's personal engineering layer for Pi: evidence-based QA, reuse checks and institutional-memory integration.",
  "keywords": [
    "pi-package"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/pi-qa/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "test:live": "node scripts/run-tests.mjs --live"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.4.2",
    "typebox": "^1.3.34",
    "typescript": "^5.7.2"
  }
}
